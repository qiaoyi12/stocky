# STOCKY backend environment config template.
# Copy to backend/.env for local dev, or paste these keys (with real values)
# into the Lightsail Container Service deployment's environment variables.
# Never commit a file containing real values.

LLM_PROVIDER=gateway
LLM_GATEWAY_URL=https://api.softwaresystems.app
LLM_GATEWAY_API_KEY=replace-with-your-real-key
LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional overrides (defaults shown):
# DATABASE_URL=sqlite:///./stocky.db
# LLM_MAX_TOKENS=1024